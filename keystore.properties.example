# Copy this file to `keystore.properties` (same folder) and fill in your own values.
#
# `keystore.properties` and the .jks itself are git-ignored and must never be committed.
# Both modules read this one file, so the phone and watch apps are always signed with the
# same key -- the Wearable Data Layer refuses to deliver between apps signed differently,
# and it fails silently, so a mismatch shows up as "sync just stopped working".
#
# Generate the keystore first:
#
#   keytool -genkeypair -v -keystore release.jks -alias procrastination-tracker \
#           -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.jks
storePassword=
keyAlias=procrastination-tracker
keyPassword=
