<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".ProcrastinationTrackerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProcrastinationTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProcrastinationTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opened from the watch ("ver/editar no celular"). RemoteActivityHelper can only fire
              a BROWSABLE VIEW intent at the phone, so the app needs a URI to answer to.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="procrastinationtracker" android:host="open" />
            </intent-filter>
        </activity>

        <!--
          Bubble target. allowEmbedded + documentLaunchMode are what let the system host this
          activity inside the floating window instead of opening the full app.
        -->
        <activity
            android:name=".ui.BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:theme="@style/Theme.ProcrastinationTracker" />

        <!--
          Quick Settings tile: pause/resume from the shade. Works on every Android, which is the
          point, since the floating bubble depends on a feature some OEMs (Samsung) don't ship.
        -->
        <service
            android:name=".service.TrackerTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".service.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus/break countdown timer notification" />
        </service>

        <service
            android:name=".service.TrackerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Active activity-tracking slice notification" />
        </service>

        <!-- Optional: lets the "Bloquear tela agora" button lock the screen without Device
             Admin. User has to enable it once in Configurações > Acessibilidade; the app works
             fully without it, this button just won't do anything until granted. -->
        <service
            android:name=".service.ScreenLockAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_lock_accessibility_service" />
        </service>

        <service
            android:name=".service.WearSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/procrastination-tracker/session"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ActivitySyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/procrastination-tracker/activity-sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Receives the other device's "I am counting X" broadcast (live session hand-off). -->
        <service
            android:name=".service.LiveSessionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/procrastination-tracker/live-session"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>
