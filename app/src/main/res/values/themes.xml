<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The app is dark-canvas only. This theme is what the system paints *before* Compose runs
      (splash + window background), so it has to be the canvas color or the app opens with a white
      flash. Colors come from colors.xml, which mirrors BoardTokens in `:core`.
    -->
    <style name="Theme.ProcrastinationTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas_top</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:colorAccent">@color/accent_blue</item>
    </style>
</resources>
